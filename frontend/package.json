{
  "name": "argus-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "ARGUS dashboard — 3D Live Command + 2D Analytics over real Bengaluru",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "bake:map": "node scripts/bake-bangalore.mjs --bbox 12.93,77.56,13.01,77.65 --out data/",
    "bake:gtfs": "node scripts/fetch-gtfs.mjs --agency bmtc --out data/",
    "bake:tiles": "bash scripts/extract-pmtiles.sh",
    "bake": "npm run bake:map && npm run bake:gtfs && npm run bake:tiles"
  },
  "dependencies": {
    "three": "^0.185.1",
    "maplibre-gl": "^5.0.0",
    "deck.gl": "^9.0.0",
    "@deck.gl/geo-layers": "^9.0.0",
    "h3-js": "^4.1.0",
    "animejs": "^3.2.2",
    "pmtiles": "^4.0.0"
  },
  "devDependencies": {
    "vite": "^8.2.2"
  }
}
