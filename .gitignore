# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.tsbuildinfo

