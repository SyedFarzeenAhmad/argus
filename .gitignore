*.mov
*.mkv
*.avi

# ── Baked map tiles (regenerate with frontend/scripts/bake-bangalore.mjs) ──
frontend/data/*.json
!frontend/data/.gitkeep

# ── Secrets ───────────────────────────────────────────────────────────────
